              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/companies",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "companies"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Lister les Entreprises",
          "request": {
            "method": "GET",
