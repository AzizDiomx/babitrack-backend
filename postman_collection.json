    {
      "name": "2. Authentification",
      "item": [
        {
          "name": "Inscription Usager (par Compagnie)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Diomandé\",\n  \"prenom\": \"Aziz\",\n  \"telephone\": \"0700000001\",\n  \"email\": \"aziz@diomande.com\",\n  \"password\": \"BabiTrack@2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register/company/:companyId",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register",
                "company",
                ":companyId"
              ],
              "variable": [
                {
                  "key": "companyId",
                  "value": "METTRE_ID_ENTREPRISE_ICI"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Connexion (Login)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const responseJson = pm.response.json();",
                  "if (responseJson.accessToken) {",
                  "    pm.environment.set(\"jwt_token\", responseJson.accessToken);",
                  "    pm.environment.set(\"refresh_token\", responseJson.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"telephone\": \"0700000001\",\n  \"password\": \"BabiTrack@2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Rafraîchir le Token",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/refresh",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "refresh"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
